{
  "name": "reportar-kit",
  "version": "1.0.0",
  "description": "Módulo reutilizável de relatos, capturas privadas e notificações por e-mail",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "public/",
    "docs/",
    "AGENTS.md",
    "ANDAMENTO.md",
    ".env.example"
  ],
  "scripts": {
    "demo": "node examples/demo.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermeforprojeto/reportar-kit.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "5.3.0",
    "modern-screenshot": "4.7.0",
    "multer": "2.5.0",
    "nodemailer": "10.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "smtp-server": "3.21.7"
  }
}
